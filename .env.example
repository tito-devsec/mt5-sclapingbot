# Copy to .env (git-ignored) and fill in only what you use. Never commit .env.

# MetaTrader 5 JustMarkets DEMO account; leave empty to attach to the logged-in terminal.
MT5BOT_MT5__TERMINAL_PATH=
MT5BOT_MT5__LOGIN=
MT5BOT_MT5__PASSWORD=
MT5BOT_MT5__SERVER=

# Optional licensed news APIs (leave empty to disable)
MT5BOT_NEWS__FINNHUB_API_KEY=
MT5BOT_NEWS__NEWSAPI_API_KEY=

# Optional LLM research adapter (disabled unless MT5BOT_LLM__ENABLED=true)
MT5BOT_LLM__ENABLED=false
MT5BOT_LLM__PROVIDER=none
MT5BOT_LLM__API_KEY=
